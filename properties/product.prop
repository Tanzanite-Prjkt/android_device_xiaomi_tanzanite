# Animation
persist.sys.activity_anim_perf_override=true

# FM Radio
ro.fm.chip=0x6631
ro.fm.band=1
ro.fm.low_band=875
ro.fm.high_band=1080
ro.fm.seek_space=1
ro.fm.max_scan_num=40
ro.fm.seek_lev=4
ro.fm.scan_sort=0
ro.fm.short_ana_sup=1
ro.fm.rssi_th_l2=-102
ro.fm.noise_floor_detect=true
ro.fm.fake_chans=4
ro.fm.fake_chan_0=9210 -205
ro.fm.fake_chan_1=9600 -152
ro.fm.fake_chan_2=10400 -152
ro.fm.fake_chan_3=10750 -205

# Skia tracing
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false

# Product Name
ro.product.marketname=Redmi Note 14

# ZRAM writeback
ro.zram_backing_device_min_free_mb=1536
# Surfaceflinger
ro.surface_flinger.game_default_frame_rate_override=120
debug.sf.auto_latch_unsignaled=1
debug.sf.disable_backpressure=1
debug.sf.defer_refresh_rate_when_off=1
debug.sf.enable_egl_image_tracker=0
debug.sf.enable_hwc_vds=0
debug.sf.enable_gl_backpressure=1
debug.sf.high_fps_late_sf_phase_offset_ns=-12666667
debug.sf.high_fps_early_phase_offset_ns=-12666667
debug.sf.high_fps_early_gl_phase_offset_ns=-12666667
debug.sf.high_fps_late_app_phase_offset_ns=-8000000
debug.sf.hw=0
debug.sf.predict_hwc_composition_strategy=0
debug.sf.treat_170m_as_sRGB=1
debug.sf.region_sampling_duration_ns=8333333
debug.sf.region_sampling_period_ns=99999984
debug.sf.region_sampling_timer_timeout_ns=99999984
ro.surface_flinger.clear_slots_with_set_layer_buffer=false
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.max_frame_buffer_acquired_buffers=6
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.protected_contents=true
ro.surface_flinger.supports_background_blur=1
ro.surface_flinger.use_color_management=true
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.wcg_composition_dataspace=143261696
ro.surface_flinger.vsync_event_phase_offset_ns=8400000
ro.surface_flinger.vsync_sf_event_phase_offset_ns=-10933333

# Animation
persist.sys.activity_anim_perf_override=true
