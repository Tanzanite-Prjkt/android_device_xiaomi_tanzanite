# RIL
vendor.rild.libpath=mtk-ril.so
vendor.rild.libargs=-d /dev/ttyC0
ro.radio.device_type=1

# Network
net.tcp.262144,524288,1048576,262144,524288,1048576=1
ro.telephony.call_ring.delay=0
ro.ril.disable.power.collapse=0

# Memory
ro.zram.mark_idle_delay_mins=60
ro.zram.first_wb_delay_mins=1440
persist.sys.zram_enabled=1
dalvik.vm.heapstartsize=8m
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=2m
dalvik.vm.heapmaxfree=8m
ro.config.max_starting_bg=16
ro.MAX_HIDDEN_APPS=64
cached_apps_limit=64
ro.lmk.kill_heaviest_task=true
ro.lmk.upgrade_pressure=40
ro.lmk.downgrade_pressure=30
ro.lmk.thrashing_limit_decay=50

# Audio
persist.vendor.audio.fluence.voicecall=true
persist.vendor.audio.fluence.speaker=true
persist.audio.lowlatency=1
ro.config.vc_call_vol_steps=14
persist.vendor.audio.vpp.enable=0
persist.sys.audio.spatializer.enabled=false
persist.device_config.runtime_native.us_pinner_v2=true

# Connsys
persist.vendor.connsysfw.enable=true

# Dexopt
dalvik.vm.dex2oat64.enabled=true

# WLAN
wifi.interface=wlan0
ro.mediatek.wlan.wsc=1
ro.mediatek.wlan.p2p=1
mediatek.wlan.ctia=0
wifi.tethering.interface=ap0
wifi.direct.interface=p2p0

# Graphics
ro.opengles.version=196610

# USB
ro.sys.usb.mtp.whql.enable=0
ro.sys.usb.storage.type=mtp
ro.sys.usb.bicr=no
ro.sys.usb.charging.only=yes

# IPO
sys.ipo.pwrdncap=2
sys.ipo.disable=1

# Audio
ro.audio.flinger_standbytime_ms=1000
ro.audio.ihaladaptervendorextension_enabled=true
ro.audio.silent=0
ro.audio.usb.period_us=16000
ro.camera.sound.forced=0
ro.vendor.audio.notification.single=true

# Zygote
ro.zygote.preload.enable=0

# Kernel
ro.kernel.zio=38,108,105,16

# MTKPerf
ro.mtk_perf_simple_start_win=1
ro.mtk_perf_fast_start_win=1
ro.mtk_perf_response_time=1

# SurfaceFlinger
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.vsync_event_phase_offset_ns=2000000
ro.surface_flinger.vsync_sf_event_phase_offset_ns=6000000
ro.surface_flinger.set_idle_timer_ms=0
ro.surface_flinger.use_content_detection_for_refresh_rate=true

# Identity
Build.BRAND=MTK

# Disable iorapd
ro.iorapd.enable=false

# async property set
ro.property_service.async_persist_writes=true

# Example Defintions
ro.product.marketname=Redmi Note 14 4G
ro.infinity.soc=Mediatek Helio G99 Ultra
ro.infinity.camera=108MP + 2MP + Auxiliary lens

# Graphics / SurfaceFlinger
ro.surface_flinger.support_content_type=false

# Sensors
persist.vendor.sensors.debug.als=0
persist.vendor.sensors.display_algo.als=0

# Audio
ro.vendor.audio.hifi=false