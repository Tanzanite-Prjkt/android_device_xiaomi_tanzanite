type vendor_overheat_fix, domain;
type vendor_overheat_fix_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_overheat_fix)

# Basic execution permissions
allow vendor_overheat_fix vendor_shell_exec:file rx_file_perms;
allow vendor_overheat_fix vendor_toolbox_exec:file rx_file_perms;

# Sysfs permissions
allow vendor_overheat_fix sysfs_therm:dir r_dir_perms;
allow vendor_overheat_fix sysfs_therm:file rw_file_perms;
allow vendor_overheat_fix sysfs_devices_system_cpu:file rw_file_perms;
allow vendor_overheat_fix sysfs_power_supply:dir r_dir_perms;
allow vendor_overheat_fix sysfs_power_supply:file rw_file_perms;
allow vendor_overheat_fix sysfs_gpu:file rw_file_perms;

# Proc permissions
allow vendor_overheat_fix proc_vm_dirty:file rw_file_perms;
allow vendor_overheat_fix proc_printk:file rw_file_perms;
allow vendor_overheat_fix proc_sched:file rw_file_perms;
allow vendor_overheat_fix proc_net:file r_file_perms;

# Capabilities
dontaudit vendor_overheat_fix self:capability { sys_admin dac_override setattr };

# Logging
allow vendor_overheat_fix logdr_socket:sock_file write;
allow vendor_overheat_fix logd:unix_stream_socket connectto;

get_prop(vendor_overheat_fix, boot_status_prop)
